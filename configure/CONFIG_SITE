# CONFIG_SITE

# Make any application-specific changes to the EPICS build configuration
# variables in this file. Host/target specific settings can be given in files
# named CONFIG_SITE.$(EPICS_HOST_ARCH).Common, CONFIG_SITE.Common.$(T_A) or
# CONFIG_SITE.$(EPICS_HOST_ARCH).$(T_A).

# Check the support modules in the RELEASE files for consistency.
CHECK_RELEASE = YES

# Host IOC only.
CROSS_COMPILER_TARGET_ARCHS =

# To install into a location other than $(TOP), define INSTALL_LOCATION.
#INSTALL_LOCATION = </absolute/path/to/install/top>

# Set this when the IOC and build host use different paths to the install
# location.
#IOCS_APPL_TOP = </IOC's/absolute/path/to/install/top>

# GUI launcher (bin/<arch>/stxspress-gui):
# - a shell script it sources first to set up EDM (optional)
XSPRESS_GUI_ENV =
# - the file it reads XSPRESS_NUM_CARDS from, as the IOC's environment
XSPRESS_IOC_ENV = /etc/xspress.d/xspress-ioc.env

# Override any of the settings above without editing this file.
-include $(TOP)/../CONFIG_SITE.local
-include $(TOP)/configure/CONFIG_SITE.local
