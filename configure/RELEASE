# RELEASE - Location of external support modules
#
# Set the real paths in configure/RELEASE.local (not committed) or in
# ../RELEASE.local; the paths below are only placeholders.
#
# This file is parsed by both GNUmake and an EPICS Perl script, so it may ONLY
# contain definitions of paths to other support modules, variable definitions
# that are used in module paths, and include statements that pull in other
# RELEASE files.

SUPPORT = /path/to/epics/support

SNCSEQ = $(SUPPORT)/sequencer
SSCAN = $(SUPPORT)/sscan
CALC = $(SUPPORT)/calc
ASYN = $(SUPPORT)/asyn
AUTOSAVE = $(SUPPORT)/autosave
BUSY = $(SUPPORT)/busy
ADSUPPORT = $(SUPPORT)/ADSupport
ADCORE = $(SUPPORT)/ADCore
RESTCLIENT = $(SUPPORT)/restClient
ADODIN = $(SUPPORT)/ADOdin

# EPICS_BASE should appear last so earlier modules can override stuff:
EPICS_BASE = /path/to/epics/base

-include $(TOP)/../RELEASE.local
-include $(TOP)/../RELEASE.$(EPICS_HOST_ARCH).local
-include $(TOP)/configure/RELEASE.local
