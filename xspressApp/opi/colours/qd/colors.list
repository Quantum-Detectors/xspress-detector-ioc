4 0 0
# QD EDM colour list, option B (QD scheme). Generated by build.py; do not edit by hand.
# Same indices and names as the SNS/DLS list; "# QD:" comments mark changed entries.
# Hex in comments is the 8-bit sRGB value; EDM values are 8-bit x 257.

blinkms=750
max=0x10000
columns=5

alias trace0 red-21
alias trace1 blue-26
alias trace2 cyan-31
alias trace3 yellow-36
alias trace4 orange-41
alias trace5 purple-46
alias trace6 "COOL title"
alias trace7 "CRYO title"
alias trace8 "RF title"
alias trace9 "UNSS title"

static 0   "Disconn/Invalid"  { 65535 65535 65535 }    #0 white
static 1   "Top Shadow"       { 62451 62965 63736 }    # QD: #f3f5f8 was #ececec; Top shadow, tinted
static 2   "grey-2"           { 57825 58853 59881 }    # QD: #e1e5e9 was #dadada; Panel/group background (lighter than canvas), tinted
static 3   "Canvas"           { 53456 54741 56026 }    # QD: #d0d5da was #c8c8c8; Canvas: site border grey #d3d3d3 level, tinted to brand hue
static 4   "Button: On"       { 47288 49087 50629 }    # QD: #b8bfc5 was #bbbbbb; Button face, tinted
static 5   "Wid-alt/Anno-sec" { 61423 62194 62965 }    # QD: #eff2f5 was #aeaeae; Control/entry well, tinted near-white
static 6   "Title"            { 35980 35980 35980 }    # QD: #8c8c8c was #9e9e9e; Title / stopped-unknown grey: no hue
static 7   "grey-7"           { 42662 43947 45489 }    # QD: #a6abb1 was #919191; grey-7 tinted
static 8   "grey-8"           { 35980 35980 35980 }    # QD: #8c8c8c was #858585; grey-8: "stopped" status grey, kept neutral (no hue = no meaning)
static 9   "Help"             { 34695 36237 37779 }    # QD: #878d93 was #787878; Help, tinted
static 10  "Monitor BG"       {  4112  6425  8738 }    # QD: #101922 was #696969; Monitor BG: near-black navy-tinted well
static 11  "Bottom Shadow"    { 23901 25700 27756 }    # QD: #5d646c was #5a5a5a; Bottom shadow / lines, tinted
static 12  "grey-12"          { 16705 18761 20560 }    # QD: #414950 was #464646; grey-12 tinted
static 13  "grey-13"          { 10794 12593 14392 }    # QD: #2a3138 was #2d2d2d; grey-13 tinted
static 14  "Black"            {  7453  8738 10023 }    # QD: #1d2227 was #000000; Ink: near-black like the site body text #222222
static 15  "Green LED: On"    { 15420 63993 22873 }    # QD: #3cf959 was #00ff00; Green LED On / running: bright
