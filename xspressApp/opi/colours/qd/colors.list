static 17  "Open/On"          {     0 22616  4883 }    # QD: #005813 was #00c000; Open/On: dark green text on the canvas
static 18  "Monitor: alt"     { 21331 48830 28784 }    # QD: #53be70 was #00a000; Monitor alt
static 19  "Green LED: Off"   { 12079 22616 12593 }    # QD: #2f5831 was #008000; Green LED Off
