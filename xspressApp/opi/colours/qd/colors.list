static 86  "Alarm text: MAJOR" { 65535 25957 23130 }    # QD: new, #ff655a; MAJOR readback text on the dark well

rule 81  test1 {
 >=20        : purple-45
 >=0 && <10  : "PS help"
 >=10 && <20 : invisible
 default     : blue-26
}

rule 82  test1Inv {
 >=40 && <45 : 79
 >=45 && <47 : blue-26
}

rule 83  vacStatus {
 >=0 && <1 : "Green LED: On"
 >=1 : "Red LED: On"
}

rule 84  alert {
 >=0 && <1 : "Canvas"
 >=1 : "Red LED: On"
}

menumap {
 "Disconn/Invalid"
 "Canvas"
 "Title"
 "Help"
 "Top Shadow"
 "Bottom Shadow"
 "Monitor BG"
 "Button: On"
 "Open/On"
 "Shut/Off"
