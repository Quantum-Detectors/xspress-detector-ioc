<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>$(DESC)</name>
  <width>192</width>
  <height>148</height>
  <grid_step_x>8</grid_step_x>
  <grid_step_y>8</grid_step_y>
  <widget type="rectangle" version="2.0.0">
    <name>body</name>
    <class>PANEL</class>
    <x>0</x>
    <y>0</y>
    <width>192</width>
    <height>148</height>
    <background_color use_class="true">
      <color name="Panel_Background" red="195" green="201" blue="207"/>
    </background_color>
    <line_color use_class="true">
      <color name="Panel_Border" red="153" green="161" blue="170"/>
    </line_color>
    <line_width use_class="true">1</line_width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>name</name>
    <class>SECTION</class>
    <x>8</x>
    <y>4</y>
    <width>176</width>
    <height>24</height>
    <font use_class="true">
      <font name="Header 3" family="Liberation Sans" style="BOLD" size="16.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <transparent use_class="true">true</transparent>
    <text>$(DESC)</text>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="multi_state_led" version="2.0.0">
    <name>state_led</name>
    <x>8</x>
    <y>34</y>
    <width>20</width>
    <height>20</height>
    <pv_name>$(P)$(R)$(SVC):STATE</pv_name>
    <square>false</square>
    <states>
      <state>
        <value>0</value>
        <label/>
        <color>
          <color name="Off" red="245" green="245" blue="245"/>
        </color>
      </state>
      <state>
        <value>1</value>
        <label/>
        <color>
          <color name="LED_Green_Off" red="47" green="88" blue="49"/>
        </color>
      </state>
      <state>
        <value>2</value>
        <label/>
        <color>
          <color name="LED_Amber_On" red="255" green="228" blue="125"/>
        </color>
      </state>
      <state>
        <value>3</value>
        <label/>
        <color>
          <color name="LED_Green_On" red="60" green="249" blue="89"/>
        </color>
      </state>
      <state>
        <value>4</value>
        <label/>
        <color>
          <color name="LED_Red_On" red="255" green="37" blue="36"/>
        </color>
      </state>
    </states>
    <fallback_label/>
    <fallback_color>
      <color name="Off" red="245" green="245" blue="245"/>
    </fallback_color>
    <line_color>
      <color name="Equipment_Border" red="90" green="90" blue="90"/>
    </line_color>
    <font>
      <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color>
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <border_alarm_sensitive>true</border_alarm_sensitive>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>state</name>
    <class>VALUE</class>
    <x>32</x>
    <y>32</y>
    <width>88</width>
    <height>24</height>
    <font use_class="true">
      <font name="Value" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Read_Background" red="225" green="229" blue="232"/>
    </background_color>
    <transparent use_class="true">false</transparent>
    <border_alarm_sensitive use_class="true">true</border_alarm_sensitive>
    <pv_name>$(P)$(R)$(SVC):STATE</pv_name>
    <horizontal_alignment>0</horizontal_alignment>
    <format>6</format>
    <wrap_words>false</wrap_words>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>cpu</name>
    <class>VALUE</class>
    <x>124</x>
    <y>32</y>
    <width>60</width>
    <height>24</height>
    <font use_class="true">
      <font name="Value" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Read_Background" red="225" green="229" blue="232"/>
    </background_color>
    <transparent use_class="true">false</transparent>
    <border_alarm_sensitive use_class="true">true</border_alarm_sensitive>
    <pv_name>$(P)$(R)$(SVC):CPU</pv_name>
    <tooltip>CPU use</tooltip>
    <horizontal_alignment>2</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>active</name>
    <class>VALUE</class>
    <x>8</x>
    <y>60</y>
    <width>176</width>
    <height>24</height>
    <font use_class="true">
      <font name="Value" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Read_Background" red="225" green="229" blue="232"/>
    </background_color>
    <transparent use_class="true">false</transparent>
    <border_alarm_sensitive use_class="true">true</border_alarm_sensitive>
    <pv_name>$(P)$(R)$(SVC):ACTIVE</pv_name>
    <horizontal_alignment>0</horizontal_alignment>
    <format>6</format>
    <wrap_words>false</wrap_words>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>restarts_label</name>
    <class>LABEL</class>
    <x>8</x>
    <y>88</y>
    <width>64</width>
    <height>24</height>
    <font use_class="true">
      <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text_Muted" red="75" green="75" blue="75"/>
    </foreground_color>
    <transparent use_class="true">true</transparent>
    <text>Restarts</text>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>nrestarts</name>
    <class>VALUE</class>
    <x>72</x>
    <y>88</y>
    <width>40</width>
    <height>24</height>
    <font use_class="true">
      <font name="Value" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Read_Background" red="225" green="229" blue="232"/>
    </background_color>
    <transparent use_class="true">false</transparent>
    <border_alarm_sensitive use_class="true">true</border_alarm_sensitive>
    <pv_name>$(P)$(R)$(SVC):NRESTARTS</pv_name>
    <horizontal_alignment>2</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>details</name>
    <class>BUTTON</class>
    <x>120</x>
    <y>88</y>
    <width>64</width>
    <height>24</height>
    <font use_class="true">
      <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Button_Background" red="233" green="237" blue="240"/>
    </background_color>
    <text>Details</text>
    <actions>
      <action type="open_display">
        <file>xspress_service.bob</file>
        <macros>
          <SVC>$(SVC)</SVC>
          <DESC>$(DESC)</DESC>
          <LISTENERS>$(LISTENERS)</LISTENERS>
        </macros>
        <target>window</target>
        <description>$(DESC) details</description>
      </action>
    </actions>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>start</name>
    <class>BUTTON</class>
    <x>8</x>
    <y>116</y>
    <width>56</width>
    <height>24</height>
    <font use_class="true">
      <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Button_Background" red="233" green="237" blue="240"/>
    </background_color>
    <text>Start</text>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)$(R)$(SVC):START</pv_name>
        <value>1</value>
        <description>Start</description>
      </action>
    </actions>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>stop</name>
    <class>BUTTON</class>
    <x>68</x>
    <y>116</y>
    <width>56</width>
    <height>24</height>
    <font use_class="true">
      <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Button_Background" red="233" green="237" blue="240"/>
    </background_color>
    <text>Stop</text>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)$(R)$(SVC):STOP</pv_name>
        <value>1</value>
        <description>Stop</description>
      </action>
    </actions>
    <show_confirm_dialog>true</show_confirm_dialog>
    <confirm_message>Stop $(DESC)?</confirm_message>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>restart</name>
    <class>BUTTON</class>
    <x>128</x>
    <y>116</y>
    <width>56</width>
    <height>24</height>
    <font use_class="true">
      <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Button_Background" red="233" green="237" blue="240"/>
    </background_color>
    <text>Restart</text>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)$(R)$(SVC):RESTART</pv_name>
        <value>1</value>
        <description>Restart</description>
      </action>
    </actions>
    <show_confirm_dialog>true</show_confirm_dialog>
    <confirm_message>Restart $(DESC)?</confirm_message>
  </widget>
</display>
