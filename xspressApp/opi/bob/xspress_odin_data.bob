  <widget type="action_button" version="3.0.0">
    <name>reset</name>
    <class>BUTTON</class>
    <x>768</x>
    <y>0</y>
    <width>136</width>
    <height>24</height>
    <font use_class="true">
      <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Button_Background" red="233" green="237" blue="240"/>
    </background_color>
    <text>Reset stats</text>
    <actions>
      <action type="write_pv">
        <pv_name>$(P):OD$(RANK):ResetStatistics.PROC</pv_name>
        <value>1</value>
        <description>Reset stats</description>
      </action>
    </actions>
  </widget>
  <widget type="label" version="2.0.0">
    <name>error_label</name>
    <class>LABEL</class>
    <x>44</x>
    <y>28</y>
    <width>112</width>
    <height>24</height>
    <font use_class="true">
      <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text_Muted" red="75" green="75" blue="75"/>
    </foreground_color>
    <transparent use_class="true">true</transparent>
    <text>Error</text>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>error_message</name>
    <class>VALUE</class>
    <x>160</x>
    <y>28</y>
    <width>596</width>
    <height>24</height>
    <font use_class="true">
      <font name="Value" family="Liberation Sans" style="REGULAR" size="14.0"/>
