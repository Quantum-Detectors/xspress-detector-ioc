    </background_color>
    <transparent use_class="true">false</transparent>
    <border_alarm_sensitive use_class="true">true</border_alarm_sensitive>
    <pv_name>$(P):OD$(RANK):FPErrorMessage_RBV</pv_name>
    <horizontal_alignment>0</horizontal_alignment>
    <format>6</format>
    <wrap_words>false</wrap_words>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>clear</name>
    <class>BUTTON</class>
    <x>768</x>
    <y>28</y>
    <width>136</width>
    <height>24</height>
