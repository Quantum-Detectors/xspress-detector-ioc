<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>FEM $(CARD)</name>
  <width>832</width>
  <height>24</height>
  <grid_step_x>8</grid_step_x>
  <grid_step_y>8</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>card</name>
    <x>0</x>
    <y>0</y>
    <width>64</width>
    <height>24</height>
    <text>Card $(CARD)</text>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0"/>
    </font>
    <foreground_color>
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <transparent>true</transparent>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="led" version="2.0.0">
    <name>connected</name>
    <class>LED_GREEN</class>
    <x>80</x>
    <y>2</y>
    <width>20</width>
    <height>20</height>
    <on_color use_class="true">
      <color name="LED_Green_On" red="60" green="249" blue="89"/>
    </on_color>
    <off_color use_class="true">
      <color name="LED_Green_Off" red="47" green="88" blue="49"/>
    </off_color>
    <pv_name>$(P)$(R)FEM$(CARD):CONNECTED</pv_name>
    <line_color>
      <color name="Equipment_Border" red="90" green="90" blue="90"/>
    </line_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>channels</name>
    <class>VALUE</class>
    <x>120</x>
    <y>0</y>
    <width>96</width>
    <height>24</height>
    <font use_class="true">
      <font name="Value" family="Liberation Sans" style="REGULAR" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Read_Background" red="225" green="229" blue="232"/>
    </background_color>
    <transparent use_class="true">false</transparent>
    <border_alarm_sensitive use_class="true">true</border_alarm_sensitive>
    <pv_name>$(P)$(R)FEM$(CARD):NUM_CHANNELS</pv_name>
    <horizontal_alignment>2</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
