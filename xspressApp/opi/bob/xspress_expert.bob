        <color name="Button_Background" red="233" green="237" blue="240"/>
      </background_color>
      <text>Restore</text>
      <actions>
        <action type="write_pv">
          <pv_name>$(P)$(R)RESTORE_SETTINGS</pv_name>
          <value>1</value>
          <description>Restore</description>
        </action>
      </actions>
      <show_confirm_dialog>true</show_confirm_dialog>
      <confirm_message>Restore the settings from the configuration path?</confirm_message>
    </widget>
