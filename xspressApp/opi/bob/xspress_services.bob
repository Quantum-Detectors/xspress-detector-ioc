    <line_width use_class="true">1</line_width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Stack_title</name>
    <class>SECTION</class>
    <x>28</x>
    <y>76</y>
    <width>248</width>
    <height>24</height>
    <font use_class="true">
      <font name="Header 3" family="Liberation Sans" style="BOLD" size="16.0"/>
