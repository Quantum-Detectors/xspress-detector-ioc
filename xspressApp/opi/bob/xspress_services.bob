<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Services</name>
  <width>800</width>
  <height>324</height>
  <background_color>
    <color name="Background" red="210" green="215" blue="220"/>
  </background_color>
  <grid_step_x>8</grid_step_x>
  <grid_step_y>8</grid_step_y>
  <widget type="rectangle" version="2.0.0">
    <name>header</name>
    <class>HEADER_BAR</class>
    <x>0</x>
    <y>0</y>
    <width>800</width>
    <height>48</height>
    <background_color use_class="true">
      <color name="Header_Background" red="5" green="57" blue="93"/>
    </background_color>
    <line_color use_class="true">
      <color name="Header_Background" red="5" green="57" blue="93"/>
    </line_color>
    <line_width use_class="true">0</line_width>
  </widget>
  <widget type="picture" version="2.0.0">
    <name>logo</name>
    <x>16</x>
    <y>8</y>
    <width>32</width>
    <height>32</height>
    <file>$(theme_root)/header_logo.png</file>
  </widget>
  <widget type="label" version="2.0.0">
    <name>title</name>
    <class>TITLE</class>
    <x>56</x>
    <y>2</y>
    <width>400</width>
    <height>32</height>
    <font use_class="true">
      <font name="Screen_Title" family="Liberation Sans" style="BOLD" size="22.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Header_Text" red="255" green="255" blue="255"/>
    </foreground_color>
    <transparent use_class="true">true</transparent>
    <text>Xspress services</text>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>subtitle</name>
    <x>56</x>
    <y>30</y>
    <width>400</width>
    <height>16</height>
    <text>$(P)$(R)</text>
    <font>
      <font name="Fine Print" family="Liberation Sans" style="REGULAR" size="12.0"/>
    </font>
    <foreground_color>
      <color name="Header_Text" red="255" green="255" blue="255"/>
    </foreground_color>
    <transparent>true</transparent>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>nav_1</name>
    <class>NAV_BUTTON</class>
    <x>632</x>
    <y>8</y>
    <width>112</width>
    <height>32</height>
    <font use_class="true">
      <font name="Nav" family="Liberation Sans" style="BOLD" size="14.0"/>
    </font>
    <foreground_color use_class="true">
      <color name="Nav_Text" red="255" green="255" blue="255"/>
    </foreground_color>
    <background_color use_class="true">
      <color name="Nav_Background" red="0" green="44" blue="75"/>
    </background_color>
    <text>Connections</text>
    <actions>
      <action type="open_display">
        <file>xspress_service_edges.bob</file>
        <target>tab</target>
        <description>All connections</description>
      </action>
    </actions>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>pop_out_background</name>
    <x>752</x>
    <y>8</y>
    <width>32</width>
    <height>32</height>
    <line_width>0</line_width>
    <line_color>
      <color name="Nav_Background" red="0" green="44" blue="75"/>
    </line_color>
    <background_color>
      <color name="Nav_Background" red="0" green="44" blue="75"/>
    </background_color>
    <corner_width>4</corner_width>
    <corner_height>4</corner_height>
  </widget>
  <widget type="picture" version="2.0.0">
    <name>pop_out_icon</name>
    <x>758</x>
    <y>14</y>
    <width>20</width>
    <height>20</height>
    <file>pop_out.svg</file>
    <stretch_image>true</stretch_image>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>pop_out</name>
    <x>752</x>
    <y>8</y>
    <width>32</width>
    <height>32</height>
    <text></text>
    <transparent>true</transparent>
    <tooltip>Open a large copy of this screen in a new window</tooltip>
    <actions>
      <action type="open_display">
        <file>xspress_services_large.bob</file>
        <macros>
          <P>$(P)</P>
          <R>$(R)</R>
        </macros>
        <target>window</target>
        <description>Open large in a new window</description>
      </action>
    </actions>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>start_sc</name>
    <x>464</x>
    <y>8</y>
    <width>160</width>
    <height>32</height>
    <font>
      <font name="Nav" family="Liberation Sans" style="BOLD" size="14.0"/>
    </font>
    <foreground_color>
      <color name="Text" red="25" green="25" blue="25"/>
    </foreground_color>
    <background_color>
      <color name="MINOR" red="255" green="170" blue="0"/>
    </background_color>
    <text>Start service control</text>
    <tooltip>Service control is not running. Start it (asks for your password).</tooltip>
    <actions>
      <action type="command">
        <command>pkexec /usr/bin/systemctl start qd-xspress-service-control</command>
        <description>Start qd-xspress-service-control</description>
      </action>
    </actions>
    <rules>
      <rule name="only_when_not_running" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0 is None">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 is None)">
          <value>false</value>
        </exp>
        <pv_name>$(P)$(R)STATE</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>accent</name>
    <class>ACCENT_STRIP</class>
    <x>0</x>
    <y>48</y>
    <width>800</width>
    <height>4</height>
    <background_color use_class="true">
      <color name="Accent_Strip" red="0" green="122" blue="191"/>
    </background_color>
    <line_color use_class="true">
      <color name="Accent_Strip" red="0" green="122" blue="191"/>
    </line_color>
    <line_width use_class="true">0</line_width>
  </widget>
  <widget type="rectangle" version="2.0.0">
