    <x>480</x>
    <y>336</y>
    <width>97</width>
    <height>2</height>
    <points>
      <point x="96.0" y="0.0"/>
      <point x="0.0" y="0.0"/>
    </points>
    <line_width>2</line_width>
    <line_color>
      <color name="Divider" red="174" green="181" blue="188"/>
    </line_color>
    <line_style>1</line_style>
    <arrows>2</arrows>
    <arrow_length>8</arrow_length>
    <tooltip>E:XCTRL-CARD1-P30124</tooltip>
    <rules>
      <rule name="edge_state" prop_id="line_color" out_exp="false">
        <exp bool_exp="pv0==4">
          <value>
            <color name="MAJOR" red="220" green="0" blue="0"/>
          </value>
        </exp>
        <exp bool_exp="pv0==2">
          <value>
            <color name="MINOR" red="255" green="170" blue="0"/>
          </value>
        </exp>
        <exp bool_exp="pv0==3">
          <value>
            <color name="Process_Line" red="110" green="110" blue="110"/>
          </value>
        </exp>
        <pv_name>$(P)$(R)E:XCTRL-CARD1-P30124:STATE</pv_name>
      </rule>
    </rules>
  </widget>
